# Server configuratie
PORT=3001
WEBSOCKET_PORT=3002
HOST=0.0.0.0

# CorelDRAW configuratie
CORELDRAW_VERSION=2021
# Pad naar het CorelDRAW uitvoerbare bestand
CORELDRAW_PATH=C:\Program Files\Corel\CorelDRAW Graphics Suite 2021\Programs\CorelDRW.exe

# Voor ontwikkeling zonder CorelDRAW installatie
MOCK_CORELDRAW=true

# Authentication (for future use)
API_KEY=your_api_key_here

# Logging
LOG_LEVEL=info 