FROM node:18-slim

WORKDIR /app

# Installeer systeemafhankelijkheden
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Kopieer package.json bestanden
COPY package*.json ./

# Installeer dependencies
RUN npm ci --omit=dev

# Maak log directory
RUN mkdir -p logs

# Kopieer broncode
COPY src/ ./src/
# COPY config/ ./config/

# Expose API port
EXPOSE 3000

# Stel omgevingsvariabelen in
ENV PORT=3000
ENV HOST=0.0.0.0
ENV MOCK_CORELDRAW=true
ENV LOG_LEVEL=info
ENV DEBUG=false

# Start de applicatie
CMD ["node", "src/server.js"] 