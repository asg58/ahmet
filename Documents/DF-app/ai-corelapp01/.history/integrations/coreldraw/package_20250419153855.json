{
  "name": "coreldraw-bridge",
  "version": "1.0.0",
  "description": "Bridge service for CorelDRAW integration via COM/VBA",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "watch": "nodemon --watch src -e ts --exec ts-node src/index.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "morgan": "^1.10.0",
    "winston": "^3.10.0",
    "winax": "^3.4.0",
    "node-json-db": "^2.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.18",
    "@types/cors": "^2.8.14",
    "@types/morgan": "^1.9.5",
    "@types/node": "^20.8.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
} 