FROM node:18-alpine

WORKDIR /app

# Copy package.json en package-lock.json
COPY package*.json ./

# Installeer dependencies
RUN npm install

# Kopieer de rest van de applicatie
COPY . .

# Bouw de Next.js applicatie
RUN npm run build

# Expose port 3000
EXPOSE 3000

# Start de applicatie
CMD ["npm", "run", "dev"] 